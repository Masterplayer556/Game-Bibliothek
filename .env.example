# Game Bibliothek – alle Variablen. Kopiere diese Datei nach .env.local für lokale Läufe.
# .env.local wird NIE committet.

# --- Build (öffentlich, landen im Browser-Code) ---------------------------------
# Wo eintragen: Datei .env.production im Repo (beide Werte sind öffentlich). GitHub-Variablen
# mit demselben Namen haben Vorrang.
# Woher: Supabase → Project Settings → API (Project URL) bzw. API Keys (Publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pfad der Seite auf GitHub Pages (= "/" + Repo-Name). Leer lassen bei eigener Domain.
NEXT_PUBLIC_BASE_PATH=/Game-Bibliothek

# --- GitHub Actions Secrets (nur Sync-Skript, nie im Browser) --------------------
# Wo eintragen: GitHub → Settings → Secrets and variables → Actions → Tab «Secrets».
# Dieselbe Adresse wie NEXT_PUBLIC_SUPABASE_URL. Leer lassen: dann gilt der Wert von oben.
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (beginnt mit sb_secret_). Voller Zugriff!
SUPABASE_SECRET_KEY=
# Schlüssel für die Verschlüsselung der Plattform-Tokens: 32 Byte, base64.
# Erzeugen: in der App auf der Startseite («Schlüssel erzeugen») oder `openssl rand -base64 32`.
CREDENTIALS_ENCRYPTION_KEY=
# Supabase-Zugangstoken, auf dieses eine Projekt beschränkt. Nur für den Workflow, der
# Edge Functions hochlädt: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Nur nötig, wenn es im Supabase-Projekt mehr als einen Nutzer gibt.
ALLOWED_EMAIL=
# Steam (Phase 5): https://steamcommunity.com/dev/apikey und deine SteamID64.
STEAM_API_KEY=
STEAM_ID=
# IGDB (Phase 7): Twitch-Entwicklerkonsole, https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Supabase Edge Function Secrets (Phase 6 und 8) ------------------------------
# Wo eintragen: Supabase → Edge Functions → Secrets.
# ALLOWED_EMAIL=                  deine Login-E-Mail
# CREDENTIALS_ENCRYPTION_KEY=     derselbe Wert wie oben
# GITHUB_DISPATCH_TOKEN=          fein eingeschränkter GitHub-Token, nur dieses Repo, nur «Actions: Read and write»
# GITHUB_REPO=Masterplayer556/Game-Bibliothek

# PSN- und Nintendo-Tokens stehen NICHT hier. Sie liegen verschlüsselt in der Datenbank.
